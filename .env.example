# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy this file to .env and fill in your own values.
#
# IMPORTANT: Never commit .env to GitHub.
#            .env is listed in .gitignore for this reason.
#            This .env.example file is safe to commit — it contains no real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Shared secret used to sign and verify incoming webhooks.
# Both the webhook sender (simulator) and the receiver (server) must share
# this same value.  In production, use a long, random, high-entropy string.
WEBHOOK_SECRET=your-super-secret-key-here

# TCP port the Express server listens on.
PORT=3000
